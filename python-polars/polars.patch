diff --git a/py-polars-nanocode/Cargo.toml b/py-polars-nanocode/Cargo.toml
new file mode 100644
index 0000000..f20895d
--- /dev/null
+++ b/py-polars-nanocode/Cargo.toml
@@ -0,0 +1,25 @@
+[package]
+name = "py-polars-nanocode"
+version = "1.33.1"
+edition = "2021"
+
+[lib]
+name = "py_polars_nanocode"
+crate-type = ["staticlib", "rlib"]
+
+# py-polars' own "full" feature set minus what needs threads, sockets, files
+# or tokio on wasm32-unknown-unknown: cloud, parquet, json (ndjson scans go
+# through cloud options), extract_jsonpath, clipboard, decompress, sql,
+# new_streaming, polars_cloud_*, catalog.
+[dependencies]
+polars-python = { workspace = true, default-features = false, features = [
+  "c_api", "pymethods", "optimizations", "dtypes", "meta", "regex",
+  "binary_encoding", "csv",
+  "approx_unique", "array_any_all", "array_count", "bitwise", "is_in", "repeat_by",
+  "trigonometry", "sign", "performant", "list_gather", "list_filter", "list_count",
+  "list_sets", "list_any_all", "list_drop_nulls", "list_sample", "cutqcut", "rle",
+  "extract_groups", "pivot", "asof_join", "cross_join", "pct_change", "index_of",
+  "search_sorted", "merge_sorted", "top_k", "propagate_nans", "timezones", "peaks",
+  "hist", "find_many", "string_normalize",
+] }
+pyo3 = { workspace = true, features = ["abi3-py39", "chrono", "extension-module", "multiple-pymethods"] }
