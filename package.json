{
  "name": "nanocode-ts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json && tsc -p tsconfig.cloudflare.build.json && node scripts/pyodide.mjs",
    "check": "vp check --fix",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.vercel.json && tsc --noEmit -p tsconfig.cloudflare.json",
    "prepare": "node scripts/prepare.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./transports": {
      "types": "./dist/transports/index.d.ts",
      "default": "./dist/transports/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./cloudflare/python": {
      "types": "./dist/cloudflare/python.d.ts",
      "default": "./dist/cloudflare/python.js"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "default": "./dist/vercel/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./nanocode_wasm.wasm": "./dist/nanocode_wasm.wasm",
    "./interpreter.wasm": "./dist/interpreter.wasm",
    "./pyodide-modules": {
      "types": "./dist/pyodide/modules.d.ts",
      "default": "./dist/pyodide/modules.js"
    }
  },
  "bundleDependencies": [
    "@cloudflare/containers",
    "nanocode-egress",
    "undici"
  ],
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "accounts": "0.21.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "mppx": "0.16.0",
    "nanocode-egress": "https://github.com/nanocodexyz/egress/releases/download/build-ec47028/nanocode-egress-ec47028.tgz",
    "ox": "0.14.56",
    "rehype-harden": "1.1.8",
    "rehype-sanitize": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "undici": "7.30.1",
    "unified": "11.0.5",
    "viem": "2.57.7"
  },
  "peerDependencies": {
    "@pierre/highlights": "^0.2.0",
    "@vercel/oidc": "^3.2.0",
    "@vercel/sandbox": "^3.9.0",
    "durable-harness": "0.0.1-beta.6",
    "pyodide": ">=0.28.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pierre/highlights": {
      "optional": true
    },
    "@vercel/oidc": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "durable-harness": {
      "optional": true
    },
    "pyodide": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@pierre/highlights": "0.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@vercel/oidc": "3.2.0",
    "@vercel/sandbox": "3.9.0",
    "durable-harness": "0.0.1-beta.6",
    "pyodide": "^314.0.7",
    "typescript": "6.0.2",
    "vite-plus": "0.2.4"
  }
}
